# Copie para .env e ajuste por ambiente. Nenhum valor aqui é secreto.

# Endereço público da Central de Ajuda (canonical, sitemap, Open Graph).
PUBLIC_SITE_URL=https://help.sileai.app

# Endereços do produto usados nos links "Ir para o Sile", Privacidade e Termos.
PUBLIC_APP_URL=https://app.sileai.app
PUBLIC_MARKETING_URL=https://sileai.app

# Contato do suporte exibido no rodapé e no fim dos artigos.
PUBLIC_SUPPORT_EMAIL=suporte@sileai.app

# Opcional: endpoint que recebe o feedback dos artigos ("Este artigo resolveu sua dúvida?").
# Vazio = o componente funciona, mas não envia nada (só registra no navegador de quem respondeu).
PUBLIC_FEEDBACK_ENDPOINT=

# Só para as capturas de tela (scripts/docs-screenshots). Precisa ser um servidor local
# do Sile em modo de documentação, com dados fictícios. URLs fora de localhost são recusadas.
DOCS_APP_URL=http://localhost:5174
