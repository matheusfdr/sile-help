# help.sileai.app em hospedagem compartilhada (LiteSpeed/Apache), as mesmas regras do site.
# O build copia este arquivo para dist/ sem alterações.

Options -MultiViews -Indexes
DirectoryIndex index.html
# /atendimento é página (atendimento.html) e pasta (atendimento/inbox.html): nunca acrescentar barra
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS e sem www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Links antigos com .html vão para a URL limpa
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteCond %1 !^index$ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Sem barra no fim (trailingSlash: 'never'), inclusive quando página e pasta têm o mesmo nome
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L]

  # URLs limpas: /atendimento/inbox serve atendimento/inbox.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
