---
// "Nesta página": sticky column on wide screens, collapsible block above the text otherwise.
import Icon from '../Icon.astro';
interface Props { headings: { depth: number; slug: string; text: string }[]; variant?: 'column' | 'inline' }
const { headings, variant = 'column' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 2 ? (
  variant === 'column' ? (
    <nav class="toc" aria-labelledby="toc-title" data-toc>
      <p class="toc__title" id="toc-title">Nesta página</p>
      <ol>
        {items.map((h) => <li class={h.depth === 3 ? 'toc__sub' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  ) : (
    <details class="toc-mobile">
      <summary>Nesta página<Icon name="chevron-down" size={16} /></summary>
      <nav class="toc" aria-label="Nesta página">
        <ol>
          {items.map((h) => <li class={h.depth === 3 ? 'toc__sub' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    </details>
  )
) : null}

<script>
  // Highlights the section being read in the column TOC.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc && 'IntersectionObserver' in window) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) => links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${id}`));
    const visible = new Set<string>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      const first = targets.find((t) => visible.has(t.id));
      if (first) setActive(first.id);
    }, { rootMargin: '-80px 0px -60% 0px' });
    targets.forEach((t) => io.observe(t));
  }
  // The inline TOC closes after choosing a section.
  document.querySelectorAll<HTMLDetailsElement>('.toc-mobile').forEach((d) => d.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) d.open = false; }));
</script>
