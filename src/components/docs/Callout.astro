---
// Same visual language as the product's Alert. Variants: info (default), tip, warning, danger.
import Icon from '../Icon.astro';
interface Props { type?: 'info' | 'tip' | 'warning' | 'danger'; title?: string }
const { type = 'info', title } = Astro.props;
const icon = { info: 'info', tip: 'lightbulb', warning: 'triangle-alert', danger: 'circle-alert' }[type];
const role = type === 'warning' || type === 'danger' ? 'note' : undefined;
---
<aside class:list={['callout', `callout--${type}`]} role={role}>
  <span class="callout__icon"><Icon name={icon} size={18} /></span>
  <div class="callout__main">
    {title ? <p class="callout__title">{title}</p> : null}
    <div class="callout__body"><slot /></div>
  </div>
</aside>
